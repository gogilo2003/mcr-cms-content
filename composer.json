{
    "name": "mcr/cms-content",
    "description": "Content publishing engine package for the Modular CMS",
    "type": "laravel-library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "mcr/cms-core": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Mcr\\Cms\\Content\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mcr\\Cms\\Content\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mcr\\Cms\\Content\\Providers\\ContentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
